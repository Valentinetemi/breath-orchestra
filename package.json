{
  "name": "breath-orchestra",
  "version": "1.0.0",
  "description": "A webcam instrument: breathe to swell a cello, flute, violin, or piano, and let pulse shape the drums, then loop and layer an ensemble.",
  "main": "src/main/main.js",
  "author": "Temiloluwa Valentine",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "npm run build && electron .",
    "start:sim": "npm run build && electron . --sim",
    "test": "node --test test/*.test.js",
    "test:headless": "node test/sim-headless.js",
    "lint": "eslint src test scripts",
    "test:e2e": "node test/e2e-practice.js",
    "test:audio": "node test/audio-graph.js",
    "build": "node scripts/build-sdk.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "tone": "^15.1.22"
  },
  "optionalDependencies": {
    "@smartspectra/node-sdk": "^3.5.0"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "esbuild": "^0.25.12",
    "eslint": "^9.15.0"
  },
  "build": {
    "appId": "dev.temiloluwa.breath-orchestra",
    "productName": "Breath Orchestra",
    "mac": {
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSCameraUsageDescription": "Breath Orchestra uses the camera to read the movement of your chest as you breathe, so you can play music with your breath. Video never leaves this computer."
      }
    }
  }
}
